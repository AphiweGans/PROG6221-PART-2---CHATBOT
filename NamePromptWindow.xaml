<Window x:Class="CyberAware.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter your name - CyberAware" Height="258" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0b0b0b"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <!-- Decorative, green-accented prompt to match the app theme. Only visual changes; logic unchanged. -->
    <Border Margin="8" CornerRadius="8" BorderThickness="1" BorderBrush="#114422" Background="#0e0f0e">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                <Rectangle Height="36" Fill="#082b16" DockPanel.Dock="Left" Width="8" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Enter your name" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#9ef59e" />
            </DockPanel>

            <!-- Input area -->
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock Text="Please enter your name:" Margin="0,0,0,6" FontSize="14" Foreground="#cdeccd" />
                <TextBox Name="NameBox" Height="36" FontSize="14" Background="#08100b" Foreground="#dfffe0" BorderBrush="#1fa84b" BorderThickness="1" Padding="8" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <!-- Make OK the default button so pressing Enter activates it -->
                <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click" Background="#1fa84b" Foreground="Black" BorderBrush="#166d2f" Padding="6,4" IsDefault="True" />
                <!-- Allow Escape to cancel the dialog -->
                <Button Content="Cancel" Width="90" Click="Cancel_Click" Background="#203a2e" Foreground="#bfe6c1" BorderBrush="#114422" Padding="6,4" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
