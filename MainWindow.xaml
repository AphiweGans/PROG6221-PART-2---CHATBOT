<Window x:Class="CyberAware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberAware Chatbot" Height="640" Width="1000" Background="#121212">
    <Window.Resources>
        <!-- Default style for TextBlocks used in the chat so programmatically created TextBlocks
             inherit readable white color, larger font and wrap to the chat area width. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="800" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.ColumnSpan="3" Background="#111111" Padding="12" CornerRadius="6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo: shield-like badge with CA initials -->
                    <Border Width="44" Height="44" CornerRadius="8" Background="#062b12" BorderBrush="#2ECC71" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="CA" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="CyberAware" Foreground="#2ECC71" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="THE DIGITAL VAULT" Foreground="#9AAFB0" FontSize="10" Margin="0,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ASCII / Welcome art area -->
                <TextBlock x:Name="HeaderAscii" Grid.Column="1" FontFamily="Consolas" Foreground="#A7F3D0" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <TextBlock Text="Logged in:" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" />
                        <!-- Bind to the existing NameTextBlock.Text so no code-behind changes required -->
                        <TextBlock x:Name="LoggedInTextBlock" Foreground="#E6FDF0" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Text="{Binding Text, ElementName=NameTextBlock}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="System Status:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Background="#062b12" CornerRadius="12" Padding="6,4" BorderBrush="#2ECC71" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pulsing secure indicator -->
                                <Ellipse x:Name="SecurePulse" Width="12" Height="12" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#2ECC71" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Text="Secure" Foreground="#2ECC71" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Animation to create a gentle pulsing effect on the secure indicator -->
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="SecurePulse" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.35" Duration="0:0:1.2" />
                                    <DoubleAnimation Storyboard.TargetName="SecurePulse" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.35" Duration="0:0:1.2" />
                                    <DoubleAnimation Storyboard.TargetName="SecurePulse" Storyboard.TargetProperty="Opacity" From="0.85" To="1" Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left topics panel always visible for easy access -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0d0d0d" CornerRadius="6" Padding="8" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Topics" Foreground="#2ECC71" FontSize="18" FontWeight="Bold" Margin="4" />
                <TextBox Name="TopicSearchBox" Height="30" FontSize="14" Margin="0,4,0,8" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Name="TopicsScrollUp" Content="▲" Height="28" Width="40" HorizontalAlignment="Left" Margin="0,0,0,6" Click="TopicsScrollUp_Click" />
                <ListBox Grid.Row="1" Name="TopicsPanel" Background="#0d0d0d" Foreground="White" BorderThickness="0" FontSize="14" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="420" />
                <Button Grid.Row="2" Name="TopicsScrollDown" Content="▼" Height="28" Width="40" HorizontalAlignment="Left" Margin="0,6,0,0" Click="TopicsScrollDown_Click" />
            </Grid>
            </StackPanel>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="1" Grid.Column="1" Background="#161616" CornerRadius="12" Padding="12">
            <ScrollViewer Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ChatPanel" />
            </ScrollViewer>
        </Border>

        <!-- Full-window black overlay used during greeting audio -->
        <Grid x:Name="BlackOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="Black" Visibility="Collapsed">
            <!-- intentionally blank to show pure black screen during greeting -->
        </Grid>

        <!-- Input area -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Border CornerRadius="8" BorderBrush="#2ECC71" BorderThickness="2" Padding="2" VerticalAlignment="Center" Width="760">
                <TextBox Name="InputBox" Height="40" VerticalContentAlignment="Center" FontSize="16" Background="#1a1a1a" Foreground="#E6FDF0" BorderThickness="0" />
            </Border>
            <Button Name="SendButton" Content="Send" Width="90" Margin="10,0,0,0" Click="SendButton_Click"
                    Background="#1a1a1a" Foreground="#E6FDF0" BorderBrush="#2ECC71" BorderThickness="1" />
            <Button Name="ClearButton" Content="Clear" Width="90" Margin="10,0,0,0" Click="ClearButton_Click"
                    Background="#1a1a1a" Foreground="#E6FDF0" BorderBrush="#2ECC71" BorderThickness="1" />
            <Button Name="ExitButton" Content="Exit" Width="90" Margin="10,0,0,0" Click="ExitButton_Click"
                    Background="#1a1a1a" Foreground="#E6FDF0" BorderBrush="#2ECC71" BorderThickness="1" />
        </StackPanel>

        <!-- Right-hand Memory & Recall sidebar -->
        <Border Grid.Row="1" Grid.Column="2" Background="#0d0d0d" CornerRadius="6" Padding="12" Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="Memory &amp; Recall" Foreground="#2ECC71" FontSize="16" FontWeight="Bold" Margin="2" />
                <Separator Margin="0,6,0,6" />
                <TextBlock Text="User Profile" Foreground="#9AAFB0" FontWeight="SemiBold" />
                <TextBlock x:Name="NameTextBlock" Text="Name: -" Foreground="#E6FDF0" Margin="0,6,0,0" />
                <TextBlock x:Name="FavoriteTopicTextBlock" Text="Favorite Topic: -" Foreground="#E6FDF0" Margin="0,4,0,0" />
                <TextBlock x:Name="LastTopicTextBlock" Text="Last Topic: -" Foreground="#9AAFB0" Margin="0,4,0,0" FontSize="12" />
                <Separator Margin="0,8,0,8" />
                <TextBlock x:Name="SentimentAlert" Text="" Visibility="Collapsed" Background="#FFBF00" Foreground="#111111" Padding="6" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>