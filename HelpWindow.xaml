<Window x:Class="CyberAware.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topics" Height="520" Width="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#121212">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Available Cybersecurity Topics" Foreground="#2ECC71" FontSize="20" FontWeight="Bold" />

        <!-- Content area: left = list + search, right = preview -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBox Name="SearchBox" Height="32" FontSize="14" Margin="0,0,0,8" />
                <Border Background="#0d0d0d" CornerRadius="6" BorderBrush="#233244" BorderThickness="1" Padding="6" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Name="TopicsUpButton" Content="▲" Width="40" Height="28" HorizontalAlignment="Left" Margin="0,0,0,6" Click="TopicsUpButton_Click" />
                        <ListBox Grid.Row="1" Name="TopicsList" Background="#0d0d0d" Foreground="White" BorderThickness="0" FontSize="16" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                                            <Ellipse Fill="#2ECC71" />
                                        </Grid>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="White" FontSize="16" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Name="TopicsDownButton" Content="▼" Width="40" Height="28" HorizontalAlignment="Left" Margin="0,6,0,0" Click="TopicsDownButton_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="#0d0d0d" CornerRadius="6" Margin="12,0,0,0" BorderBrush="#233244" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Preview" Foreground="#2ECC71" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Name="PreviewBox" TextWrapping="Wrap" Foreground="White" FontSize="16" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="AskButton" Content="Ask" Width="100" Margin="0,0,8,0" Click="AskButton_Click" />
            <Button Name="CloseButton" Content="Close" Width="100" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
